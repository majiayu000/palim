  "standard_probe_source": "use jsondiffpatch_rs::{apply_json_patch, Patch};\nuse serde_json::{Value, json};\nfn main() {\n let cases = vec![\n (\"numeric_scalar\",json!({\"x\":1}),json!([{\"op\":\"test\",\"path\":\"/x\",\"value\":1.0}])),\n (\"numeric_nested\",json!({\"x\":{\"y\":[1]}}),json!([{\"op\":\"test\",\"path\":\"/x\",\"value\":{\"y\":[1.0]}}])),\n (\"root_move_self\",json!({\"x\":1}),json!([{\"op\":\"move\",\"from\":\"\",\"path\":\"\"}])),\n (\"same_integer\",json!({\"x\":1}),json!([{\"op\":\"test\",\"path\":\"/x\",\"value\":1}])),\n ];\n for (name,doc,p) in cases {\n  let patch:Patch=serde_json::from_value(p).unwrap();\n  let out:Value=match apply_json_patch(&doc,&patch) {\n   Ok(v)=>json!({\"name\":name,\"ok\":true,\"output\":v}),\n   Err(e)=>json!({\"name\":name,\"ok\":false,\"error\":e.to_string()})\n  };\n  println!(\"{out}\");\n }\n}\n",
