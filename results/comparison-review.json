  "supplementary_benchmark_source": "use jsondiffpatch_rs::{Delta,DiffOptions,DiffPatcher,patch,reverse};\nuse serde_json::{Value,json};\nuse std::{fs,hint::black_box,sync::Arc,time::Instant};\nfn encoded(engine:&str, dp:&DiffPatcher,a:&Value,b:&Value)->Vec<u8> {\n match engine {\n  \"native\"=>serde_json::to_vec(&dp.diff(a,b).unwrap()).unwrap(),\n  \"native_to_rfc\"=>{let d=dp.diff(a,b).unwrap();let p=d.map(|d|d.to_json_patch(a).unwrap()).unwrap_or_default();serde_json::to_vec(&p).unwrap()},\n  \"json_patch\"=>serde_json::to_vec(&json_patch::diff(a,b)).unwrap(),\n  _=>unreachable!()\n }\n}\nfn main(){\n let dp=DiffPatcher::new(DiffOptions{object_hash:Some(Arc::new(|v,_|v.get(\"id\").map(Value::to_string))),..Default::default()});\n let mut inputs=Vec::new();\n let base=\"/Users/apple/Desktop/code/AI/tool/secrets/jsondiffpatch-rs/results/fixtures/\";\n for name in [\"small-config-edit\",\"prepend-2000\",\"rotate-2000\",\"disjoint-2000\",\"keyed-rotate-edit-2000\",\"crates-metadata-rotate-edit-100\",\"long-text-ascii\"] {\n  inputs.push(serde_json::from_slice::<Value>(&fs::read(format!(\"{base}{name}.json\")).unwrap()).unwrap());\n }\n for n in [100,500] {let a:Vec<usize>=(0..n).collect();let b:Vec<usize>=(n/2..n).chain(0..n/2).collect();inputs.push(json!({\"name\":format!(\"half-swap-{n}\"),\"left\":a,\"right\":b}));}\n let mut rows=Vec::new();\n for input in &inputs {let a=&input[\"left\"];let b=&input[\"right\"];let raw_a=serde_json::to_vec(a).unwrap();let raw_b=serde_json::to_vec(b).unwrap();\n  for engine in [\"native\",\"native_to_rfc\",\"json_patch\"] {\n   let bytes=encoded(engine,&dp,a,b);\n   let parsed:Value=serde_json::from_slice(&bytes).unwrap();\n   let ops=if engine==\"native\" {if parsed.is_null(){assert_eq!(a,b)}else{let d=Delta::from_value(parsed.clone()).unwrap();assert_eq!(patch(a,&d).unwrap(),*b);assert_eq!(patch(b,&reverse(&d).unwrap()).unwrap(),*a);}None}\n   else {let p:json_patch::Patch=serde_json::from_slice(&bytes).unwrap();let mut copy=a.clone();json_patch::patch(&mut copy,&p).unwrap();assert_eq!(copy,*b);Some(p.0.len())};\n   let call=||{let a:Value=serde_json::from_slice(&raw_a).unwrap();let b:Value=serde_json::from_slice(&raw_b).unwrap();black_box(encoded(engine,&dp,&a,&b));};\n   for _ in 0..20 {call();}\n   let start=Instant::now();for _ in 0..5 {call();}let each=start.elapsed().as_secs_f64()/5.;\n   let iterations=(0.020/each.max(0.0000001)).ceil().clamp(1.,100000.) as usize;\n   let mut samples=Vec::new();for _ in 0..5 {let start=Instant::now();for _ in 0..iterations {call();}samples.push(start.elapsed().as_secs_f64()*1000./iterations as f64);}\n   let mut sorted=samples.clone();sorted.sort_by(f64::total_cmp);\n   let row=json!({\"name\":input[\"name\"],\"engine\":engine,\"pipeline_ms\":sorted[2],\"samples_ms\":samples,\"iterations_per_sample\":iterations,\"bytes\":bytes.len(),\"operations\":ops,\"correct\":true});\n   eprintln!(\"{} {} {:.4}ms {}B\",input[\"name\"],engine,sorted[2],bytes.len());rows.push(row);\n  }\n }\n println!(\"{}\",serde_json::to_string_pretty(&json!({\"method\":\"single process sequential; 20 warmups; 5 batches calibrated to >=20ms; parse both JSON values + diff + typed serialize; native_to_rfc includes public export API; no memory measurement\", \"rows\":rows})).unwrap());\n}\n",
