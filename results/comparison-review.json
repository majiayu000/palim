    "source": "use jsondiffpatch_rs::{Delta, reverse, patch};\nuse serde_json::json;\nfn main() {\n let text=format!(\"@@ -{},0 +0,0 @@\\n-a\\n+b\\n\",usize::MAX);\n let d=Delta::from_value(json!([text,0,2])).unwrap();\n println!(\"accepted={} forward={:?}\",true,patch(&json!(\"a\"),&d));\n let result=std::panic::catch_unwind(||reverse(&d));\n match result { Ok(r)=>println!(\"reverse={r:?}\"),Err(_)=>println!(\"reverse_panicked=true\") }\n}\n",
